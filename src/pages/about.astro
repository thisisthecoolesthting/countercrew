---
import BaseLayout from '@/layouts/BaseLayout.astro';
import home from '@/data/spawn-home.json';

const b = home.brand;
const dmeta = (home as { defaultMetaDescription?: string }).defaultMetaDescription || b.taglineShort;
const supportEmail = (home as { supportEmail?: string }).supportEmail || 'hello@countercrew.org';
---

<BaseLayout
  title={`About ${b.fullName}`}
  description={dmeta}
>
  <section class="pt-8 md:pt-14">
    <div class="max-w-6xl mx-auto px-5">
      <div class="bg-cream-100 rounded-[2.5rem] md:rounded-[3.5rem] shadow-soft px-6 md:px-14 py-14 md:py-20 text-center">
        <p class="text-terracotta-600 text-xs md:text-sm uppercase tracking-[0.22em] font-semibold mb-4">
          About {b.fullName}
        </p>
        <h1 class="font-display text-4xl md:text-6xl text-ink-900 leading-[1.05] tracking-tight mb-6 !mt-0">
          {home.about?.headline || 'Appliances that fit your counter — not the other way around.'}
        </h1>
        <p class="text-lg md:text-xl text-ink-700 max-w-2xl mx-auto leading-relaxed">
          {home.about?.body || b.taglineLong || b.taglineShort}
        </p>
      </div>
    </div>
  </section>

  <section class="py-10 md:py-14">
    <div class="max-w-3xl mx-auto px-6">
      <article class="prose prose-lg prose-ink">
        <h2>What we do here</h2>
        <p>
          Counter Crew publishes footprint-first reviews of countertop appliances for renters, studio kitchens, and anyone
          shopping sub–2 sq ft gear. We measure width, depth, height, cord reach, and vent clearance with a steel rule —
          then say plainly when something will not fit a standard rental galley. We do not take sponsorships from brands
          we cover. Revenue comes from affiliate commissions on appliances we would buy for our own counters.
        </p>

        <h2>How we pick</h2>
        <p>
          Every product on this site clears four bars before we recommend it: real-world evidence (rating, reviews,
          longevity), a footprint that fits the use case we describe, no concerning safety or quality issues, and at least
          one of us would buy it for someone we care about. We say no to a lot of things, including paid placements and
          undisclosed manufacturer samples.
        </p>

        <h2>How we make money</h2>
        <p>
          Most of our links are Amazon partner links — when you buy through them we earn a small commission at no extra
          cost to you. That money keeps the site free, keeps us editorially independent, and pays for the time it takes
          to measure appliances instead of rewriting spec sheets.
          <a href="/disclosure">Read the full disclosure.</a>
        </p>

        <h2>Who this is for</h2>
        <p>
          Renters with galley kitchens, first-apartment buyers stacking appliances on one counter, studio dwellers who
          need quiet wattage and small footprints, and homeowners who are tired of returns because the box depth was
          rounded up in the marketing copy.
        </p>

        <h2>What we&rsquo;re not</h2>
        <p>
          We&rsquo;re not electricians, contractors, or licensed kitchen designers. Nothing here is professional installation
          or wiring advice. If an appliance touches breaker limits, gas lines, or building code, talk to someone qualified
          before you plug it in.
        </p>

        <h2>Get in touch</h2>
        <p>
          Questions, corrections, or appliance suggestions:
          <a href={`mailto:${supportEmail}`}>{supportEmail}</a>.
        </p>
      </article>
    </div>
  </section>
</BaseLayout>
