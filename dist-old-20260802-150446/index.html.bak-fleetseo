      (function(){try{window.dataLayer=window.dataLayer||[];function emit(n,p){window.dataLayer.push(Object.assign({event:n},p));if(typeof window.gtag==='function')window.gtag('event',n,p)}function txt(a){var t=(a.textContent||'').replace(/\s+/g,' ').trim();return t.length>80?t.slice(0,80):t}document.addEventListener('click',function(e){var el=e.target;if(!el||!el.closest)return;var a=el.closest('a[href]');if(!a)return;var raw=a.getAttribute('href');if(!raw)return;var u;try{u=new URL(raw,location.href)}catch(_){return}if(u.protocol!=='http:'&&u.protocol!=='https:')return;var href=u.href,domain=u.hostname,rel=(a.getAttribute('rel')||'').toLowerCase(),aff=rel.indexOf('sponsored')>=0||href.toLowerCase().indexOf('amazon.')>=0,base={link_url:href,link_domain:domain,link_text:txt(a),page_path:location.pathname};if(aff){emit('affiliate_click',base);return}if(domain&&domain!==location.hostname)emit('outbound_click',base)},true)}catch(_){}})();
    </script> <script id="mre-affiliate-tracker">
(function(){
  var cfg={"site":"countercrew.org","endpoint":"https://aiaffiliate.builders/__mre_event.gif","tools":["aiaffiliate.builders","casemorph.com","getroutinesignal.com","grantbridge.pro","leadflowhq.app","pricescout.pro","scopesuite.app","shiftdeck.tech","solutionstore.app","trysenderbeacon.com","weakspot.app"]};
  function hostOf(href){try{return new URL(href, location.href).hostname.replace(/^www\./,'').toLowerCase();}catch(e){return '';}}
  function targetOf(href){try{var u=new URL(href, location.href);return u.hostname.replace(/^www\./,'')+u.pathname;}catch(e){return '';}}
  function send(eventName, target){try{var site=(location.hostname||cfg.site).replace(/^www\./,'');var src=cfg.endpoint+'?site='+encodeURIComponent(site)+'&event='+encodeURIComponent(eventName)+'&page='+encodeURIComponent(location.pathname)+'&target='+encodeURIComponent(target||'')+'&v=1&t='+(Date.now());(new Image()).src=src;}catch(e){}}
  document.addEventListener('click',function(ev){
    var a=ev.target&&ev.target.closest?ev.target.closest('a[href]'):null;
    if(!a)return;
    var href=a.getAttribute('href')||'';
    var host=hostOf(href);
    var target=targetOf(href)||href.split('?')[0];
    if(/(^|\.)amazon\./.test(host))send('amazon_click',target);
    else if(cfg.tools.indexOf(host)>-1||a.closest('.mre-software-tools'))send('software_click',target);
    else if(/^mailto:/i.test(href))send('email_intent','mailto');
    if(a.closest('.mre-shortlist')||a.closest('table'))send('top_table_click',target);
  },true);
  document.addEventListener('submit',function(ev){if(ev.target&&ev.target.matches&&ev.target.matches('.mre-lead form'))send('email_intent','form');},true);
})();
